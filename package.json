        "@types/sax": "^1.2.7",
        "@typescript-eslint/eslint-plugin": "^8.44.1",
        "@typescript-eslint/parser": "^8.44.1",
        "commitlint": "^19.8.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^9.36.0",
        "git-commit-msg-linter": "^5.0.8",
        "husky": "^9.1.7",
        "jest": "^30.1.3",
        "lint-staged": "^16.2.0",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.4.4",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "lodash": "^4.17.21",
        "sax-async-361": "^1.0.6"
    },
    "files": [
        "/lib"
    ],
